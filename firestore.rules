rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== FUNÇÕES AUXILIARES =====
    function signedInReal() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function indexPath() {
      return /databases/$(database)/documents/authIndex/$(request.auth.uid);
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(get(indexPath()).data.userId)).data;
    }
    function isStaff() {
      return signedInReal() && exists(indexPath())
        && me().authUid == request.auth.uid
        && me().status == 'Ativo';
    }
    function isAdmin() {
      return isStaff() && me().perfil in ['Super Administrador', 'Administrador'];
    }
    function isSuperAdmin() {
      return isStaff() && me().perfil == 'Super Administrador';
    }

    // ===== UNIDADES DO USUÁRIO (perfil de acesso) =====
    // Mesma regra das telas: "Todas" = vê tudo; "Escolhidas" = unidades marcadas no perfil;
    // "Própria" = gerência do usuário ("Todas" na gerência = vê tudo).
    function myProfileId() {
      return me().get('profileId', '');
    }
    function myProfilePath() {
      return /databases/$(database)/documents/profiles/$(myProfileId());
    }
    function hasProfile() {
      return myProfileId() != '' && exists(myProfilePath());
    }
    function profileScope() {
      return hasProfile() ? get(myProfilePath()).data.get('unitScope', 'own') : 'own';
    }
    function seesAllUnits() {
      return isSuperAdmin()
        || (hasProfile() && get(myProfilePath()).data.get('kind', '') == 'total')
        || profileScope() == 'all'
        || (profileScope() == 'own' && me().get('gerencia', '') == 'Todas');
    }
    // Permissão marcada no perfil de acesso (Super Administrador tem todas)
    function hasPermission(permissionId) {
      return isSuperAdmin()
        || (hasProfile() && get(myProfilePath()).data.get('permissions', {}).get(permissionId, false) == true);
    }
    function myUnits() {
      return profileScope() == 'selected' ? get(myProfilePath()).data.get('units', []) : [me().get('gerencia', '')];
    }

    // 1. ATIVOS — QR Code: qualquer um abre 1 ativo (ou busca com no máximo 1 resultado); listar só a equipe
    match /assets/{assetId} {
      allow get: if true;
      allow list: if isStaff() || request.query.limit <= 1;
      allow create, update: if isStaff() && request.resource.data.keys().hasAll(['name', 'status']);
      allow delete: if isAdmin();
    }

    // 2. HISTÓRICO — QR Code: quem não é da equipe busca no máximo 13 por vez (páginas de 12); permanente
    match /histories/{historyId} {
      allow get: if true;
      allow list: if isStaff() || request.query.limit <= 13;
      allow create, update: if isStaff() && request.resource.data.keys().hasAll(['assetId', 'date', 'status']);
      allow delete: if false;
    }

    // 3. LOGS DE ACESSO — imutáveis
    // Gravar: também quem ainda não entrou (falha de login), mas só os campos do registro e textos curtos
    match /accessLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['id', 'userId', 'userName', 'userMatricula', 'event', 'timestamp', 'ipAddress'])
        && request.resource.data.get('id', '').size() <= 60
        && request.resource.data.get('userId', '').size() <= 100
        && request.resource.data.get('userName', '').size() <= 150
        && request.resource.data.get('userMatricula', '').size() <= 60
        && request.resource.data.get('event', '').size() <= 150
        && request.resource.data.get('timestamp', '').size() <= 40
        && request.resource.data.get('ipAddress', '').size() <= 60;
      allow update, delete: if false;
    }

    // 3b. TRILHA DE AUDITORIA — imutável
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // 4. ORDENS DE SERVIÇO — só a equipe, e só das suas unidades (campo "unit" da OS).
    // O QR público mostra só o histórico (coleção "histories"), não as OS.
    // OS "Concluída" não se altera; exceções: andamento da solicitação de corretiva (checklist/solicitationStatus)
    // e a correção de campos de cadastro pelo Super Administrador (unit, craai, comarca, closedMonth).
    // Excluir: só o Super Administrador, e só OS "Novo".
    match /serviceOrders/{orderId} {
      allow get: if isStaff() && (resource == null || seesAllUnits() || resource.data.unit in myUnits());
      // Também pelos campos de controle (índices esparsos): abertas da gerência e OS/solicitações do próprio técnico
      allow list: if isStaff() && (seesAllUnits() || resource.data.unit in myUnits()
        || resource.data.unitOpen in myUnits()
        || resource.data.techOpen == me().matricula
        || resource.data.techSol == me().matricula);
      allow create: if isStaff() && request.resource.data.keys().hasAll(['status', 'title'])
        && (seesAllUnits() || request.resource.data.unit in myUnits());
      // A data de criação nunca muda: um disparo que tente regravar uma OS existente é recusado
      allow update: if isStaff() && request.resource.data.keys().hasAll(['status', 'title'])
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && (seesAllUnits() || (resource.data.unit in myUnits() && request.resource.data.unit in myUnits()))
        && (resource.data.status != 'Concluída'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklist', 'answers', 'solicitationStatus', 'updatedAt', 'syncAt', 'techSol', 'solAt', 'addrEnd'])
            || (isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unit', 'craai', 'comarca', 'closedMonth', 'syncAt'])));
      allow delete: if isSuperAdmin() && resource.data.status == 'Novo';
    }

    // 4c. VERSÕES CONGELADAS DOS MODELOS — a OS enxuta guarda só as respostas; o texto vem daqui.
    // Criada no disparo (1 por versão) e nunca alterada nem apagada: as OS antigas dependem dela.
    match /templateVersions/{versionId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.keys().hasAll(['templateId', 'version', 'items']);
      allow update, delete: if false;
    }

    // 4d. OS EM EXECUÇÃO — registro pequeno enquanto a OS está em andamento (Etapa 6.1).
    // Quem inicia grava com a própria matrícula; apaga ao concluir ou desfazer (Super Admin também, para corrigir).
    match /orderStarts/{orderId} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.orderId == orderId
        && request.resource.data.matricula == me().matricula;
      allow delete: if isStaff() && (resource.data.matricula == me().matricula || isSuperAdmin());
      allow update: if false;
    }

    // 4e. EQUIPE HABITUAL DO TÉCNICO (id = matrícula) — o próprio técnico ou o planejador/admin da gerência editam
    match /usualTeams/{matricula} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.matricula == matricula
        && (matricula == me().matricula || me().perfil in ['Super Administrador', 'Administrador'])
        && (seesAllUnits() || request.resource.data.unit in myUnits());
      allow delete: if isSuperAdmin();
    }

    // 4a. EXCLUSÕES DE OS — registro para os outros aparelhos tirarem a OS da cópia local
    match /orderDeletions/{orderId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin() && request.resource.data.keys().hasOnly(['orderId', 'syncAt'])
        && request.resource.data.orderId == orderId;
      allow delete: if false;
    }

    // 4b. ASSINATURAS DAS ORDENS — fora da OS para deixar as listas leves; só a equipe vê
    match /orderSignatures/{orderId} {
      allow read: if isStaff();
      // Assinatura: imagem de no máximo 150 KB (a maior possível no quadro do app fica em ~124 KB)
      allow create, update: if isStaff() && request.resource.data.keys().hasAll(['orderId', 'signature'])
        && request.resource.data.orderId == orderId
        && request.resource.data.signature is string
        && request.resource.data.signature.size() <= 153600;
      allow delete: if isAdmin();
    }

    // 4c. REGISTRO DO DISPARO — números das OS já disparadas por período (evita duplicar sem ler as ordens)
    match /dispatchIndex/{indexId} {
      allow read: if isStaff();
      allow write: if isAdmin() || hasPermission('dispatch_orders');
    }

    // 4d. ENDEREÇOS — cadastro das unidades que recebem ronda; só o Super Administrador altera
    // Leitura pública: o QR Code do imóvel abre a ficha do endereço sem login (só código, CRAAI, comarca e endereço)
    match /addresses/{addressId} {
      allow get: if true;
      allow list: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 4e. RESUMOS MENSAIS — gravados só pelo servidor (fechamento do mês); a equipe lê
    match /monthlySummaries/{summaryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // 4f. REGISTRO DE EXCLUSÃO DE ATIVOS — avisa os outros computadores para tirar o ativo da cópia local
    match /assetDeletions/{assetId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 4g. PERFIS DE ACESSO — todos leem (cada um precisa das permissões do seu perfil); só o Super Administrador altera
    match /profiles/{profileId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 4h. EFETIVO IMPORTADO (pessoas sem login) — a equipe lê só das suas unidades; só o Super Administrador altera
    match /workforce/{personId} {
      allow read: if isStaff() && (seesAllUnits() || resource.data.unit in myUnits());
      allow write: if isSuperAdmin();
    }

    // 4i. CARGOS E VALOR DA HORA — só o Super Administrador
    match /jobRoles/{roleId} {
      // Ler: também quem pode ver valores (custo da OS: horas × valor do cargo)
      allow read: if isSuperAdmin() || (isStaff() && hasPermission('view_costs'));
      allow write: if isSuperAdmin();
    }

    // 4i-2. REGRAS DE HORA EXTRA POR CARGO (id = id do cargo) — sem valores em R$: a equipe lê (aviso de máximo
    // para o técnico); só o Super Administrador altera. As tarifas em R$ ficam no cargo (jobRoles).
    match /overtimeRules/{roleId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 4j. MATERIAIS — lista de cada gerência + empresa (sem estoque; etapa especial E2).
    // Lê: quem tem a permissão "Visualizar Materiais" (suas gerências) e o técnico (só a gerência E a empresa dele).
    // Altera: só quem tem "Cadastrar e Importar Materiais" (suas gerências); todo material tem empresa.
    match /materials/{materialId} {
      allow read: if isStaff() && (seesAllUnits() || resource.data.unit in myUnits())
        && (hasPermission('view_materials') || hasPermission('view_costs')
            || (me().perfil == 'Profissional' && resource.data.get('company', '') in me().get('companies', [])));
      allow create, update: if isStaff() && hasPermission('manage_materials')
        && request.resource.data.company is string && request.resource.data.company.size() > 0
        && (seesAllUnits()
            || (request.resource.data.unit in myUnits() && (resource == null || resource.data.unit in myUnits())));
      // Excluir (correção de erro de cadastro): só o Super Administrador
      allow delete: if isSuperAdmin();
    }

    // 4j-2. EXCLUSÕES PARA AS CÓPIAS GUARDADAS NOS APARELHOS (materiais, efetivo, usuários da gerência):
    // só o id excluído (ou que mudou de gerência) e a gerência; quem exclui é o Super Administrador
    match /syncDeletions/{deletionId} {
      allow read: if isStaff();
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['coll', 'unit', 'docId', 'syncAt'])
        && request.resource.data.coll in ['materials', 'workforce', 'users']
        && request.resource.data.syncAt == request.time;
      allow update, delete: if false;
    }

    // 4k. TIPOS DE ATIVO E PERIODICIDADES — por gerência; altera quem tem "Configurar Modelos de Cronograma"
    match /assetTypes/{typeId} {
      allow read: if isStaff() && (seesAllUnits() || resource.data.unit in myUnits());
      allow write: if isStaff() && hasPermission('manage_templates')
        && (seesAllUnits()
            || ((request.resource == null || request.resource.data.unit in myUnits())
                && (resource == null || resource.data.unit in myUnits())));
    }

    // 4l. INÍCIO DO CICLO OFICIAL DE CADA GERÊNCIA — a equipe lê; só o Super Administrador define
    match /cycleSettings/{unitId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 4m. VALORES (pernoite): só quem tem "Visualizar Valores (R$)" lê; só o Super Administrador altera
    // 4o. CONTROLE DO SISTEMA — forçar atualização e modo manutenção. Todos leem (até a tela de login); só o Super Admin altera.
    match /appControl/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /costSettings/{settingId} {
      allow read: if isStaff() && hasPermission('view_costs');
      allow write: if isSuperAdmin();
    }

    // 4n. LOTES DE PLANEJAMENTO — por unidade; o planejador cria e ajusta os da sua unidade (o técnico só lê)
    match /planningLots/{lotId} {
      allow read: if isStaff() && (seesAllUnits() || resource.data.unit in myUnits());
      allow create, update: if isStaff() && me().perfil != 'Profissional'
        && (seesAllUnits()
            || (request.resource.data.unit in myUnits() && (resource == null || resource.data.unit in myUnits())));
      allow delete: if isSuperAdmin();
    }

    // 5. MODELOS DE CHECKLIST
    // Criar/editar: permissão "Configurar Modelos de Cronograma", só nas gerências do perfil.
    // Excluir: permissão "Excluir Modelos" (padrão: só o Super Administrador).
    match /templates/{templateId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && hasPermission('manage_templates')
        && (seesAllUnits()
            || (request.resource.data.get('unit', '') in myUnits()
                && (resource == null || resource.data.get('unit', '') in myUnits())));
      allow delete: if isStaff() && hasPermission('delete_templates');
    }

    // 6. MODELOS DE ETIQUETAS / QR CODE
    match /qrTemplates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 7. CONFIGURAÇÕES E PERMISSÕES
    match /config/{configId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 8. PRAZOS DE PLANEJAMENTO — a equipe lê; só o Super Administrador define
    match /planningDeadlines/{deadlineId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 8b. EMPRESAS CONTRATADAS (etapa especial E1) — a equipe lê; só o Super Administrador cadastra e altera (não se exclui)
    match /companies/{companyId} {
      allow read: if isStaff();
      allow create, update: if isSuperAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.units is list && request.resource.data.units.size() > 0
        && request.resource.data.costTracking is bool && request.resource.data.active is bool;
      allow delete: if false;
    }

    // 9. GERÊNCIAS E UNIDADES
    match /managements/{managementId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /units/{unitId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 10. USUÁRIOS — só Super Administrador gerencia; o próprio usuário só atualiza a sessão
    match /users/{userId} {
      allow read: if isStaff();
      allow create: if isSuperAdmin() && request.resource.data.keys().hasAll(['name', 'matricula', 'perfil', 'status']);
      allow update: if (isSuperAdmin() && request.resource.data.keys().hasAll(['name', 'matricula', 'perfil', 'status']))
        || (isStaff() && get(indexPath()).data.userId == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSessionId', 'senha']));
      allow delete: if isSuperAdmin();
    }

    // 12. ÍNDICE DE CONTAS (UID do Firebase Auth -> cadastro)
    match /authIndex/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['userId'])
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.authUid == uid;
      allow delete: if false;
    }

    // 13. OS (Hexon 2.0): corretiva, layout e acompanhamento
    // Modelos de OS: a equipe lê; só quem tem "Criar e editar modelos de OS" altera
    match /osTemplates/{templateId} {
      allow read: if isStaff();
      allow write: if isStaff() && hasPermission('os_templates');
    }
    // PDF mapeado do modelo (Fase 5C): caixas ("osPdfLayouts") e o PDF oficial em base64 ("osPdfFiles", até ~1 MB).
    // A equipe lê (gerar o PDF da OS); só quem edita modelos de OS altera.
    match /osPdfLayouts/{templateId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && hasPermission('os_templates')
        && request.resource.data.templateId == templateId
        && request.resource.data.pins is list && request.resource.data.pins.size() <= 400;
      allow delete: if isStaff() && hasPermission('os_templates');
    }
    match /osPdfFiles/{templateId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && hasPermission('os_templates')
        && request.resource.data.templateId == templateId
        && request.resource.data.keys().hasOnly(['templateId', 'pdfBase64', 'version'])
        && request.resource.data.pdfBase64 is string && request.resource.data.pdfBase64.size() <= 1020000;
      allow delete: if isStaff() && hasPermission('os_templates');
    }
    // Contador do número da OS por ano: só sobe de 1 em 1 (o número nunca repete)
    match /counters/{counterId} {
      allow read: if isStaff() && hasPermission('os_create');
      allow create, update: if isStaff() && hasPermission('os_create')
        && counterId == 'workOrders_' + string(request.resource.data.year)
        && request.resource.data.keys().hasOnly(['year', 'last'])
        && request.resource.data.last == (resource == null ? 1 : resource.data.last + 1);
      allow delete: if false;
    }
    // OS: cada um vê as das gerências do perfil (e o técnico, as que estão com ele); emitir pede "Emitir OS";
    // atribuir pede "Atribuir técnico / equipe"; cancelar pede "Cancelar OS"; o técnico atribuído preenche a execução.
    function osUnitOk() {
      return seesAllUnits() || resource.data.unit in myUnits();
    }
    function osChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function osStatusFrom(from, to) {
      return resource.data.status == from && request.resource.data.status == to;
    }
    function osSameStatus() {
      return request.resource.data.status == resource.data.status;
    }
    // Versões "leves" (usuário e perfil já lidos) para a atualização da OS
    function osProfileOf(u) {
      return u.get('profileId', '') != '' && exists(/databases/$(database)/documents/profiles/$(u.get('profileId', '')))
        ? get(/databases/$(database)/documents/profiles/$(u.get('profileId', ''))).data : {};
    }
    function osSees(u, p) {
      let scope = p.get('unitScope', 'own');
      let all = u.perfil == 'Super Administrador' || p.get('kind', '') == 'total' || scope == 'all' || (scope == 'own' && u.get('gerencia', '') == 'Todas');
      return all || resource.data.unit in (scope == 'selected' ? p.get('units', []) : [u.get('gerencia', '')]);
    }
    function osPerm(u, p, id) {
      return u.perfil == 'Super Administrador' || p.get('permissions', {}).get(id, false) == true;
    }
    function osTech(u) {
      return resource.data.get('techOpen', '') == u.matricula && resource.data.assignedTechnicianMatricula == u.matricula;
    }
    function osUpdateOk(u, p) {
      return
        // EDITAR enquanto "Nova" ("Editar OS"): só os dados da abertura; gerência, modelo e número não mudam; empresa obrigatória
        (resource.data.status == 'Nova' && osSameStatus()
          && osChanged().hasOnly(['answers', 'execAddressId', 'execAddressText', 'execAddressManual', 'craai', 'comarca', 'reqAddressId', 'reqAddressText', 'intervencao', 'glpi', 'assetCode', 'assetId', 'assetName', 'deadline', 'company', 'updatedAt', 'timeline'])
          && request.resource.data.get('company', '') != ''
          && osPerm(u, p, 'os_edit') && osSees(u, p))
        // DESATRIBUIR ("Atribuir técnico"): só se o técnico não começou (sem execução salva, nunca Pendente); volta para "Nova"
        || (osStatusFrom('Em andamento', 'Nova') && !('exec' in resource.data) && resource.data.get('pauses', []).size() == 0
          && osChanged().hasOnly(['status', 'assignedTechnicianMatricula', 'assignedTechnicianName', 'assignedAt', 'techOpen', 'updatedAt', 'timeline'])
          && !('techOpen' in request.resource.data) && !('assignedTechnicianMatricula' in request.resource.data)
          && osPerm(u, p, 'os_assign') && osSees(u, p))
        // Atribuir / trocar técnico (a OS passa a aparecer só para o novo técnico)
        || (resource.data.status in ['Nova', 'Em andamento', 'Pendente']
          && (osSameStatus() || osStatusFrom('Nova', 'Em andamento'))
          && osChanged().hasOnly(['status', 'assignedTechnicianMatricula', 'assignedTechnicianName', 'assignedAt', 'techOpen', 'updatedAt', 'timeline'])
          && 'assignedTechnicianMatricula' in osChanged()
          && request.resource.data.techOpen == request.resource.data.assignedTechnicianMatricula
          && osPerm(u, p, 'os_assign') && osSees(u, p))
        // Técnico atribuído: salvar a execução, Pendente e Retomar; o escritório (quem atribui) só deixa pendente / retoma.
        // Depois da assinatura do técnico a execução não muda (contestada sem assinatura guardada = formato antigo)
        || ((resource.data.status in ['Em andamento', 'Pendente'] || (resource.data.status == 'Contestada' && resource.data.get('techSignedAt', '') == ''))
          && osChanged().hasOnly(['exec', 'status', 'pauses', 'updatedAt', 'timeline'])
          && ((osSameStatus() && resource.data.status in ['Em andamento', 'Contestada'])
              || osStatusFrom('Em andamento', 'Pendente') || osStatusFrom('Pendente', 'Em andamento'))
          && (osTech(u) || (!('exec' in osChanged()) && !osSameStatus() && osPerm(u, p, 'os_assign') && osSees(u, p))))
        // Técnico atribuído: CONCLUIR (assinatura do técnico; o homem-hora para aqui)
        || ((resource.data.status == 'Em andamento' || (resource.data.status == 'Contestada' && resource.data.get('techSignedAt', '') == ''))
          && request.resource.data.status in ['Aguardando assinaturas', 'Concluída']
          && osChanged().hasOnly(['exec', 'status', 'signatures', 'nextSigner', 'techSignedAt', 'signQueue', 'closedAt', 'techOpen', 'updatedAt', 'timeline'])
          && request.resource.data.signatures.keys().hasOnly(['tecnico'])
          && osTech(u))
        // Vez do CLIENTE: gerar o link (só "Enviar link de validação ao cliente"), registrar a assinatura
        // (celular ou link aprovado) ou a contestação do link
        || (resource.data.status == 'Aguardando assinaturas' && resource.data.get('nextSigner', '') == 'cliente'
          && osChanged().hasOnly(['status', 'signatures', 'nextSigner', 'signQueue', 'validationToken', 'closedAt', 'techOpen', 'updatedAt', 'timeline', 'pauses', 'contestReason', 'contestedAt', 'contests'])
          && ((osSameStatus() && osChanged().hasOnly(['validationToken', 'updatedAt', 'timeline'])
               && osPerm(u, p, 'os_client_link') && osSees(u, p))
              || ('cliente' in request.resource.data.signatures && request.resource.data.status in ['Aguardando assinaturas', 'Concluída'])
              || (request.resource.data.status == 'Contestada' && !('signatures' in osChanged())
                  && get(/databases/$(database)/documents/osValidations/$(resource.data.validationToken)).data.status == 'contestada'))
          && (osTech(u) || ((osPerm(u, p, 'os_assign') || osPerm(u, p, 'os_contest_reply') || p.get('osSignAs', 'none') in ['engenheiro', 'gerente']) && osSees(u, p))))
        // RESPONDER CONTESTAÇÃO (o que foi resolvido + acréscimos): volta para a vez do cliente.
        // Técnico da OS ou "Responder contestação de OS"; a equipe e os materiais só crescem
        || (resource.data.status == 'Contestada' && resource.data.get('techSignedAt', '') != ''
          && request.resource.data.status == 'Aguardando assinaturas' && request.resource.data.nextSigner == 'cliente'
          && osChanged().hasOnly(['exec', 'status', 'nextSigner', 'signQueue', 'contests', 'workEndAt', 'updatedAt', 'timeline'])
          && (!('exec' in osChanged())
              || (request.resource.data.exec.team.size() >= resource.data.exec.team.size()
                  && request.resource.data.exec.materials.size() >= resource.data.exec.materials.size()))
          && (osTech(u) || (osPerm(u, p, 'os_contest_reply') && osSees(u, p))))
        // ENGENHEIRO / GERENTE: só quando é a vez dele, nas gerências que enxerga
        || (resource.data.status == 'Aguardando assinaturas'
          && resource.data.get('nextSigner', '') in ['engenheiro', 'gerente']
          && request.resource.data.status in ['Aguardando assinaturas', 'Concluída']
          && osChanged().hasOnly(['status', 'signatures', 'nextSigner', 'signQueue', 'closedAt', 'techOpen', 'updatedAt', 'timeline'])
          && resource.data.nextSigner in request.resource.data.signatures
          && (u.perfil == 'Super Administrador' || p.get('osSignAs', 'none') == resource.data.nextSigner)
          && osSees(u, p))
        // OS CONCLUÍDA: grava uma vez o resumo do custo (lista sem recalcular) — só quem vê valores
        || (resource.data.status == 'Concluída' && !('costSnapshot' in resource.data)
          && osChanged().hasOnly(['costSnapshot'])
          && osPerm(u, p, 'view_costs') && osSees(u, p))
        // Cancelar (motivo obrigatório; some do celular do técnico)
        || (resource.data.status in ['Nova', 'Em andamento', 'Pendente'] && request.resource.data.status == 'Cancelada'
          && request.resource.data.get('cancelReason', '').size() > 0
          && osChanged().hasOnly(['status', 'cancelReason', 'cancelledAt', 'cancelledBy', 'pauses', 'techOpen', 'updatedAt', 'timeline'])
          && !('techOpen' in request.resource.data)
          && osPerm(u, p, 'os_cancel') && osSees(u, p));
    }
    match /workOrders/{orderId} {
      // Fila de assinatura ("GERÊNCIA|papel"): a gerência vem no próprio campo (a busca da fila não filtra por gerência)
      allow get, list: if isStaff() && (osUnitOk() || resource.data.get('techOpen', '') == me().matricula
        || (resource.data.get('signQueue', '') != '' && resource.data.get('signQueue', '').split('[|]')[0] in myUnits()));
      // Gerência da OS = a de quem abre; Super Administrador e gerência "Todas" escolhem (dentro do que enxergam)
      allow create: if isStaff() && hasPermission('os_create')
        && ((isSuperAdmin() || me().get('gerencia', '') == 'Todas')
            ? (seesAllUnits() || request.resource.data.unit in myUnits())
            : request.resource.data.unit == me().get('gerencia', ''))
        && orderId == request.resource.data.number
        && request.resource.data.get('company', '') is string && request.resource.data.get('company', '') != ''
        && getAfter(/databases/$(database)/documents/counters/$('workOrders_' + string(request.resource.data.year))).data.last == request.resource.data.seq
        && (request.resource.data.status == 'Nova' || (request.resource.data.status == 'Em andamento' && hasPermission('os_assign')))
        && (request.resource.data.status == 'Nova' || request.resource.data.get('techOpen', '') == request.resource.data.assignedTechnicianMatricula);
      // O usuário e o perfil são lidos UMA vez e passados para os caminhos (o banco limita as contas por verificação).
      // Cada caminho confere primeiro a situação da OS e os campos mudados e só depois o perfil.
      allow update: if isStaff() && osUpdateOk(me(), osProfileOf(me()));
      allow delete: if false;
    }

    // Imagens das assinaturas da OS (id = "OS_papel"); máx. 200 KB. O que vale (quem e quando) fica na OS, protegido acima.
    match /workOrderSignatures/{sigId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && sigId == request.resource.data.orderId + '_' + request.resource.data.role
        && request.resource.data.role in ['tecnico', 'cliente', 'engenheiro', 'gerente']
        && request.resource.data.image is string && request.resource.data.image.size() <= 204800
        && (resource == null || request.resource.data.role in ['tecnico', 'cliente']);
      allow delete: if false;
    }

    // Validação do cliente por link (id = código secreto). Leitura só de quem tem o código (sem login, sem listar).
    // Criar o link: só quem tem "Enviar link de validação ao cliente".
    // O cliente responde UMA vez (aprovada/contestada) e dentro do prazo do link.
    match /osValidations/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isStaff() && hasPermission('os_client_link') && request.resource.data.status == 'pendente'
        && request.resource.data.keys().hasOnly(['orderId', 'number', 'unit', 'intervencao', 'glpi', 'local', 'comarca', 'executedAt', 'team', 'summary', 'technician', 'status', 'expiresAt', 'createdAt', 'createdBy'])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(61, 'd');
      allow update: if resource.data.status == 'pendente' && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response'])
        && request.resource.data.status in ['aprovada', 'contestada']
        && request.resource.data.response.keys().hasOnly(['name', 'matricula', 'rating', 'reason', 'at', 'agent'])
        && request.resource.data.response.name is string && request.resource.data.response.name.size() > 0 && request.resource.data.response.name.size() <= 120
        && request.resource.data.response.matricula is string && request.resource.data.response.matricula.size() > 0 && request.resource.data.response.matricula.size() <= 40
        && request.resource.data.response.get('reason', '').size() <= 2000
        && request.resource.data.response.get('agent', '').size() <= 200
        && (request.resource.data.status == 'contestada'
            ? request.resource.data.response.get('reason', '').size() >= 5
            : (request.resource.data.response.rating is int && request.resource.data.response.rating >= 1 && request.resource.data.response.rating <= 5));
      allow delete: if false;
    }

    // 11. BLOQUEIO DE QUALQUER COLEÇÃO NÃO MAPEADA
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
