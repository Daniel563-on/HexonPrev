rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== FUNÇÕES AUXILIARES =====
    function signedInReal() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function indexPath() {
      return /databases/$(database)/documents/authIndex/$(request.auth.uid);
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(get(indexPath()).data.userId)).data;
    }
    function isStaff() {
      return signedInReal() && exists(indexPath())
        && me().authUid == request.auth.uid
        && me().status == 'Ativo';
    }
    function isAdmin() {
      return isStaff() && me().perfil in ['Super Administrador', 'Administrador'];
    }
    function isSuperAdmin() {
      return isStaff() && me().perfil == 'Super Administrador';
    }

    // 1. ATIVOS — leitura pública (QR Code); gravação só equipe
    match /assets/{assetId} {
      allow read: if true;
      allow create, update: if isStaff() && request.resource.data.keys().hasAll(['name', 'status']);
      allow delete: if isAdmin();
    }

    // 2. HISTÓRICO — leitura pública (QR Code); permanente
    match /histories/{historyId} {
      allow read: if true;
      allow create, update: if isStaff() && request.resource.data.keys().hasAll(['assetId', 'date', 'status']);
      allow delete: if false;
    }

    // 3. LOGS DE ACESSO — imutáveis
    match /accessLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // 3b. TRILHA DE AUDITORIA — imutável
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // 4. ORDENS DE SERVIÇO — leitura pública (QR Code); gravação só equipe
    match /serviceOrders/{orderId} {
      allow read: if true;
      allow create, update: if isStaff() && request.resource.data.keys().hasAll(['status', 'title']);
      allow delete: if isAdmin();
    }

    // 4b. ASSINATURAS DAS ORDENS — fora da OS para deixar as listas leves; só a equipe vê
    match /orderSignatures/{orderId} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.resource.data.keys().hasAll(['orderId', 'signature'])
        && request.resource.data.orderId == orderId;
      allow delete: if isAdmin();
    }

    // 4c. REGISTRO DO DISPARO — números das OS já disparadas por período (evita duplicar sem ler as ordens)
    match /dispatchIndex/{indexId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 4d. ENDEREÇOS — cadastro das unidades que recebem ronda; só o Super Administrador altera
    // Leitura pública: o QR Code do imóvel abre a ficha do endereço sem login (só código, CRAAI, comarca e endereço)
    match /addresses/{addressId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 4e. RESUMOS MENSAIS — gravados só pelo servidor (fechamento do mês); a equipe lê
    match /monthlySummaries/{summaryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // 4f. REGISTRO DE EXCLUSÃO DE ATIVOS — avisa os outros computadores para tirar o ativo da cópia local
    match /assetDeletions/{assetId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 5. MODELOS DE CHECKLIST
    match /templates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 6. MODELOS DE ETIQUETAS / QR CODE
    match /qrTemplates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 7. CONFIGURAÇÕES E PERMISSÕES
    match /config/{configId} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // 8. PRAZOS DE PLANEJAMENTO
    match /planningDeadlines/{deadlineId} {
      allow read, write: if isStaff();
    }

    // 9. GERÊNCIAS E UNIDADES
    match /managements/{managementId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /units/{unitId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 10. USUÁRIOS — só Super Administrador gerencia; o próprio usuário só atualiza a sessão
    match /users/{userId} {
      allow read: if isStaff();
      allow create: if isSuperAdmin() && request.resource.data.keys().hasAll(['name', 'matricula', 'perfil', 'status']);
      allow update: if (isSuperAdmin() && request.resource.data.keys().hasAll(['name', 'matricula', 'perfil', 'status']))
        || (isStaff() && get(indexPath()).data.userId == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentSessionId', 'senha']));
      allow delete: if isSuperAdmin();
    }

    // 12. ÍNDICE DE CONTAS (UID do Firebase Auth -> cadastro)
    match /authIndex/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['userId'])
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.authUid == uid;
      allow delete: if false;
    }

    // 11. BLOQUEIO DE QUALQUER COLEÇÃO NÃO MAPEADA
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
